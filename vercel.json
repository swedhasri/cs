{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "JWT_SECRET": "cyber_toolkit_vercel_secret_key_2024",
    "JWT_EXPIRES_IN": "7d",
    "FRONTEND_URL": "https://cs.vercel.app"
  },
  "functions": {
    "api/index.js": {
      "maxDuration": 10
    }
  }
}